# ─── AOEN backend environment ───────────────────────────────────────────────
# Copy to backend/.env and fill in real values. Never commit real secrets (§37).

# Demo mode: when true, AOEN runs fully offline with mock data and no API keys.
DEMO_MODE=true

# Secrets (server-side only — never exposed to the browser)
TAVILY_API_KEY=
LLM_API_KEY=
# OPENAI_API_KEY is also honoured if LLM_API_KEY is unset
OPENAI_API_KEY=

# LLM (model-provider agnostic)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.0

# Infrastructure
DATABASE_URL=postgresql+asyncpg://aoen:aoen@localhost:5432/aoen
REDIS_URL=redis://localhost:6379/0

# App
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Briefing defaults
DEFAULT_NEWS_WINDOW_HOURS=24
DEFAULT_STORIES_PER_DOMAIN=5
